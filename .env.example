# Copie este arquivo para .env e preencha SOMENTE as chaves que você tiver.
# O .env NUNCA vai para o GitHub (está no .gitignore).
# Agentes pulam automaticamente os provedores sem chave.

# --- Custo zero ---------------------------------------------------------
# Ollama (local): instale em https://ollama.com e rode: ollama pull qwen3:4b
OLLAMA_URL=http://localhost:11434
# Gemini (camada gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (camada gratuita): https://console.groq.com/keys
GROQ_API_KEY=

# --- Pagos por uso (assinaturas Plus/Pro NÃO incluem crédito de API) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# --- Telegram (avisos e aprovação pelo celular, gratuito) ---------------
# 1) No Telegram, fale com @BotFather → /newbot → copie o token aqui
# 2) Rode o menu → "Conectar o Telegram" (preenche o CHAT_ID sozinho)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Obsidian (cada execução vira uma nota no seu cofre) ----------------
OBSIDIAN_VAULT=

# --- Imagens -------------------------------------------------------------
# Pexels (fotos reais, grátis para uso comercial): https://www.pexels.com/api/
PEXELS_API_KEY=
# Gemini/Nano Banana gera imagens só com faturamento ativado no AI Studio. Depois, mude para 1:
IMAGENS_GEMINI=0
# Carrossel do Instagram: seu @ e a cor de destaque
INSTAGRAM_PERFIL=
CARROSSEL_COR=#F28C28
# Carrossel do Instagram: seu @ e a cor de destaque
INSTAGRAM_PERFIL=
CARROSSEL_COR=#F28C28

# --- E-mails (Gerenciador de E-mails: python main.py emails tudo) ---------
# Em cada conta: ENDERECO = seu e-mail; SENHA_APP = "senha de app" (NÃO a senha normal).
# Para abrir de uma vez todas as páginas onde se gera a senha de app: python main.py emails paginas
# Conta sem endereço é simplesmente pulada.
EMAIL_YAHOO_ENDERECO=
EMAIL_YAHOO_SENHA_APP=
# EB: o servidor IMAP é ebmail.webmail.eb.mil.br (já testado: aceita conexão).
# Se o EB não oferecer senha de app, aqui vai a senha do webmail.
EMAIL_EB_ENDERECO=
EMAIL_EB_SENHA_APP=
# Hotmail: a Microsoft exige login autorizado (OAuth); pode não aceitar senha de app.
EMAIL_HOTMAIL_ENDERECO=
EMAIL_HOTMAIL_SENHA_APP=
# Gmails: o número é o da conta no navegador (mail.google.com/mail/u/0 = GMAIL0 …)
EMAIL_GMAIL0_ENDERECO=
EMAIL_GMAIL0_SENHA_APP=
EMAIL_GMAIL1_ENDERECO=
EMAIL_GMAIL1_SENHA_APP=
EMAIL_GMAIL2_ENDERECO=
EMAIL_GMAIL2_SENHA_APP=
EMAIL_GMAIL3_ENDERECO=
EMAIL_GMAIL3_SENHA_APP=
EMAIL_GMAIL5_ENDERECO=
EMAIL_GMAIL5_SENHA_APP=
EMAIL_GMAIL6_ENDERECO=
EMAIL_GMAIL6_SENHA_APP=
EMAIL_GMAIL7_ENDERECO=
EMAIL_GMAIL7_SENHA_APP=
# Palavras que identificam e-mails da faculdade (remetente ou assunto), separadas por vírgula
EMAIL_FACULDADE=funib,usp.br,usp,mar atlântico,mar atlantico,maratlantico,unifunib
# IAs usadas para ler e classificar (em ordem). Para não enviar nada para fora: ollama:qwen3:4b
EMAIL_IA_MODELOS=gemini:gemini-3.5-flash,groq:openai/gpt-oss-120b,gemini:gemini-flash-lite-latest,ollama:qwen3:4b
