# Copie este arquivo para .env e preencha SOMENTE as chaves que você tiver.
# O .env NUNCA vai para o GitHub (está no .gitignore).
# Agentes pulam automaticamente os provedores sem chave.

# --- Custo zero ---------------------------------------------------------
# Ollama (local): instale em https://ollama.com e rode: ollama pull qwen3:4b
OLLAMA_URL=http://localhost:11434
# Gemini (camada gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (camada gratuita): https://console.groq.com/keys
GROQ_API_KEY=

# --- Pagos por uso (assinaturas Plus/Pro NÃO incluem crédito de API) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# --- Telegram (avisos e aprovação pelo celular, gratuito) ---------------
# 1) No Telegram, fale com @BotFather → /newbot → copie o token aqui
# 2) Rode o menu → "Conectar o Telegram" (preenche o CHAT_ID sozinho)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Obsidian (cada execução vira uma nota no seu cofre) ----------------
OBSIDIAN_VAULT=

# --- Imagens -------------------------------------------------------------
# Pexels (fotos reais, grátis para uso comercial): https://www.pexels.com/api/
PEXELS_API_KEY=
# Gemini/Nano Banana gera imagens só com faturamento ativado no AI Studio. Depois, mude para 1:
IMAGENS_GEMINI=0
